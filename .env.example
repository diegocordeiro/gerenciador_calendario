# ============================================================================
# Calendário Acadêmico — IFPI Campus Barras
# Exemplo das variáveis de ambiente da IA (LLM).
#
# Uso: copie os valores que precisar para o seu shell (o settings.py lê
# apenas variáveis de ambiente — este arquivo NÃO é carregado automaticamente):
#
#   export $(grep -v '^#' .env.example | xargs)   # ou defina só a chave do provedor
#   make rodar
#
# NUNCA commite chaves de verdade nem coloque este arquivo no build estático.
# ============================================================================

# ---- Provedores (preencha a chave do provedor que vai usar) ----------------
# DeepSeek (padrão)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# ChatGPT (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Gemini (Google)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent

# Claude (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages

# ---- Comportamento ---------------------------------------------------------
# provedor padrão do modal: deepseek | openai | gemini | anthropic
# (aceita apelidos: chatgpt, claude, claudecode, google)
LLM_PROVIDER=deepseek
LLM_ENABLED=1
LLM_TIMEOUT=120
LLM_MAX_TOKENS=8000
LLM_TEMPERATURE=0.2

# ---- Localização padrão da unidade (valores iniciais do modal) -------------
LLM_CIDADE_PADRAO=Barras
LLM_ESTADO_PADRAO=PI
LLM_PAIS_PADRAO=Brasil

# ---- Site (GitHub Pages) ---------------------------------------------------
# SITE_BASE_URL=/gerenciador_calendario/   # project pages: /<repo>/
# SITE_URL=https://diegocordeiro.github.io/gerenciador_calendario
